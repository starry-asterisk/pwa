<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MoaCapture</AssemblyName>
    <RootNamespace>MoaCapture</RootNamespace>
    <StartupObject>MoaCapture.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Moa.ico</ApplicationIcon>
    <Product>모아 캡처</Product>
    <Description>모아의 Windows 화면 캡처 및 녹화 도구</Description>
    <Version>0.2.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- WPF owns process DPI via app.manifest; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Moa.ico" />
    <Resource Include="..\..\public\icon-192.png" Link="Assets\Moa.png" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Content Include="Assets\tessdata\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
